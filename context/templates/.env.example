# =============================================================================
# Rust.chat — Environment Variables
# Copy this file to .env at the project root and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
# Public URL of the frontend (used for CORS, invite links, etc.)
APP_PUBLIC_URL=http://localhost:3000
# Public URL of the API (used by frontend to know where to call)
API_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://chatapp:chatapp@localhost:5432/chatapp

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth secrets
# Change both values before deploying. Minimum 64 characters each.
# ---------------------------------------------------------------------------
# Used to sign session cookies (browser auth)
SESSION_SECRET=change-me-use-at-least-64-random-characters-here-do-not-use-this-default

# Used as pepper appended to password before Argon2id hashing
# Changing this after users exist will invalidate all existing passwords
PASSWORD_PEPPER=change-me-use-a-different-random-string-here-do-not-use-this-default

# ---------------------------------------------------------------------------
# JWT (used for native/mobile bearer token auth)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-use-at-least-64-random-characters-for-jwt-signing-do-not-use-this

# Access token TTL in seconds (default: 15 minutes)
JWT_ACCESS_TTL_SECONDS=900

# Refresh token TTL in seconds (default: 30 days)
JWT_REFRESH_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Options: local | s3 | gcs | azure
STORAGE_PROVIDER=local

# Used when STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/uploads

# Used when STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# S3_BUCKET=rust-chat-uploads
# S3_ENDPOINT=              # optional, for S3-compatible providers (e.g. MinIO)

# Used when STORAGE_PROVIDER=gcs
# GCS_BUCKET=rust-chat-uploads
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Used when STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_ACCESS_KEY=
# AZURE_CONTAINER=rust-chat-uploads

# ---------------------------------------------------------------------------
# LiveKit (optional voice/video — Phase 10)
# ---------------------------------------------------------------------------
LIVEKIT_ENABLED=false
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# NEVER expose LIVEKIT_API_SECRET to the browser or any client
LIVEKIT_API_SECRET=secret

# ---------------------------------------------------------------------------
# PikPak adapter (optional, isolated — not part of MVP)
# ---------------------------------------------------------------------------
PIKPAK_ADAPTER_ENABLED=false
PIKPAK_ADAPTER_URL=http://localhost:9000
PIKPAK_ADAPTER_SECRET=change-me

# ---------------------------------------------------------------------------
# Rate limits (requests per minute unless noted)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_MESSAGE_SEND=30
RATE_LIMIT_FILE_UPLOAD=10
RATE_LIMIT_WS_CONNECT=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Levels: trace | debug | info | warn | error
# Example filter: info,rust_chat_server=debug
RUST_LOG=info

# Format: pretty (dev) | json (prod)
LOG_FORMAT=pretty
